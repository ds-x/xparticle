<jittershader name="default">
	<description>Default Slab </description>
	<param name="scale" type="float" default="1.0" />
	<param name="tex0" type="int" default="0" />
	<param name="modelViewProjectionMatrix" type="mat4" state="MODELVIEW_PROJECTION_MATRIX" />
	<param name="textureMatrix0" type="mat4" state="TEXTURE0_MATRIX" />
	<param name="position" type="vec3" state="POSITION" />
	<param name="texcoord" type="vec2" state="TEXCOORD" />
	<param name="color" type="vec4" state="COLOR0" />
	<param name="u_resolution" type="vec2" default="1920.0 1080.0" />
	<param name="count" type="int" default="2" />
	<param name="xofs" type="float" default="0.05 0.2" />
	<param name="yofs" type="float" default="0.05 0.5" />
	<param name="width" type="float" default="0.20 0.2 " />
	<param name="height" type="float" default="0.10 0.2 " />

	<language name="glsl" version="1.5">
		<bind param="scale" program="fp" />
		<bind param="tex0" program="fp" />
		<bind param="modelViewProjectionMatrix" program="vp" />
		<bind param="textureMatrix0" program="vp" />
		<bind param="position" program="vp" />
		<bind param="texcoord" program="vp" />
		<bind param="color" program="vp" />
		<bind param="u_resolution" program="fp" type="vec2" />
		<bind param="count" program="fp" />
		<bind param="xofs" program="fp" />
		<bind param="yofs" program="fp" />
		<bind param="width" program="fp" />
		<bind param="height" program="fp" />

		<program name="vp" type="vertex" >
		<![CDATA[
			#version 330 core
			
			in vec3 position;
			in vec2 texcoord;
			out jit_PerVertex {
				vec2 texcoord;
				vec4 color;
			} jit_out;
			uniform mat4 modelViewProjectionMatrix;
			uniform mat4 textureMatrix0;
			uniform vec4 color;

			

			void main(void) {
				gl_Position = modelViewProjectionMatrix*vec4(position, 1.);
				jit_out.texcoord = vec2(textureMatrix0*vec4(texcoord, 0., 1.));
				jit_out.color = color;
			}
		]]>
		</program>
		
		<program name="fp" type="fragment"  >
		<![CDATA[
			#version 330 core
			
			in jit_PerVertex {
				vec2 texcoord;
				vec4 color;
			} jit_in;
			layout (location = 0) out vec4 outColor;
			uniform int count;
			
			const int COUNTBOX = 35;

			uniform samplerJit0 tex0;
			uniform float scale;
			
			uniform float xofs[COUNTBOX];
			uniform float yofs[COUNTBOX];
			uniform float width[COUNTBOX];
			uniform float height[COUNTBOX];
			uniform vec2 u_resolution;

			

			void main(void) {

				vec2 st = gl_FragCoord.xy / u_resolution;
				vec3 color = vec3(0.0);
				vec4 tex = texture(tex0, jit_in.texcoord);
				

				for (int i = 0; i < count; i++) {
					
					vec2 bl = step(vec2(xofs[i],yofs[i]),st);
					vec2 tr = step(vec2(1-xofs[i]-width[i],1-yofs[i]-height[i]),1.0-st);

					float pct = bl.x * bl.y * tr.x * tr.y;
					
					color += vec3(pct);
					color = clamp(color, 0.0, 1.0);
				}

    			outColor = tex * vec4(color,1.0);

			}
		]]>
		</program>
	</language>
</jittershader>
